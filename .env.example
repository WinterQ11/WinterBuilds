# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: Secret password to access the WinterBuild Admin Dashboard.
# If not set, you will be prompted to create your admin passphrase on first login.
ADMIN_PASSWORD=""

# VITE_API_BASE_URL: Centralized base URL of the live backend API for the frontend.
# Leave empty for local full-stack development (defaults to relative /api paths).
# Set to "https://winterbuilds.onrender.com" for Cloudflare Pages production frontend builds.
VITE_API_BASE_URL="https://winterbuilds.onrender.com"

# ALLOWED_ORIGINS: Comma-separated list of allowed frontend origins for CORS on the Render Express backend.
# Configure this on Render environment settings to allow your Cloudflare Pages domain(s) and preview deploys.
# Example: "https://winterbuilds.pages.dev,https://*.pages.dev,http://localhost:5173"
ALLOWED_ORIGINS="https://winterbuilds.pages.dev,https://*.pages.dev,http://localhost:5173,http://localhost:3000"

