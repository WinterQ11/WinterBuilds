# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: Secret password to access the WinterBuild Admin Dashboard.
# If not set, you will be prompted to create your admin passphrase on first login.
ADMIN_PASSWORD=""

# VITE_API_BASE_URL: Base URL of the backend API for the frontend.
# Leave empty for local development, Google AI Studio preview, and Vercel monorepo deployments (defaults to same-origin relative /api routes).
# Set to an external backend URL (e.g. "https://api.example.com") only if hosting frontend and backend on separate domains.
VITE_API_BASE_URL=

# ALLOWED_ORIGINS: Comma-separated list of allowed frontend origins for CORS on the Render Express backend.
# Configure this on Render environment settings to allow your Cloudflare Pages domain(s) and preview deploys.
# Example: "https://winterbuilds.pages.dev,https://*.pages.dev,http://localhost:5173"
ALLOWED_ORIGINS="https://winterbuilds.pages.dev,https://*.pages.dev,http://localhost:5173,http://localhost:3000"

