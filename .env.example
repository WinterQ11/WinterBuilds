# ==============================================================================
# WINTERBUILDS ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE STORAGE & DATABASE CONFIGURATION (Required for 100MB+ APK uploads)
# In Vercel Project Settings -> Environment Variables, add both:
# ------------------------------------------------------------------------------

# Supabase Project URL (e.g., https://your-project-ref.supabase.co)
# Can be named VITE_SUPABASE_URL or SUPABASE_URL (both are supported)
VITE_SUPABASE_URL=""
SUPABASE_URL=""

# Supabase Anonymous/Public API Key (for client-side auth & public reads)
VITE_SUPABASE_ANON_KEY=""
SUPABASE_ANON_KEY=""

# Supabase Service Role Secret Key (REQUIRED for generating direct browser-to-storage signed URLs)
# This allows the browser to upload 100 MB+ APKs directly to Supabase without passing through Vercel's 4.5 MB serverless limit.
SUPABASE_SERVICE_ROLE_KEY=""

# Storage bucket names (Default: "apks" and "app-media")
# IMPORTANT: In your Supabase Dashboard:
# 1. Open "Storage" -> "Buckets" -> "apks" -> Edit Bucket
# 2. Set "Public bucket" to ON
# 3. Under "Maximum file size", set to at least 150 MB (or 500 MB, or leave empty for unlimited plan limit)
VITE_SUPABASE_APK_BUCKET="apks"
VITE_SUPABASE_MEDIA_BUCKET="app-media"

# ------------------------------------------------------------------------------
# 2. APPLICATION & ADMIN CONFIGURATION
# ------------------------------------------------------------------------------

# Base URL for API endpoints. In production & Vercel, defaults to same-origin "/api"
VITE_API_BASE_URL="/api"

# Master administrator password
ADMIN_PASSWORD="winterbuilds2026!"

# Designated administrator email(s)
ADMIN_EMAILS="winterbuilds99@gmail.com"

# Optional: Google Gemini API Key for AI metadata enhancement
GEMINI_API_KEY=""

