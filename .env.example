# ==============================================================================
# WINTERBUILDS ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC CLIENT-SIDE VARIABLES (Exposed to the browser via VITE_)
# ------------------------------------------------------------------------------

# Base URL for API endpoints. In production & Vercel, defaults to same-origin "/api"
VITE_API_BASE_URL="/api"

# Supabase Project URL (e.g., https://your-project-ref.supabase.co)
VITE_SUPABASE_URL=""

# Supabase Anonymous/Public API Key (safe for browser client-side auth & public reads)
VITE_SUPABASE_ANON_KEY=""

# Optional public storage bucket name overrides (default: "apks" and "app-media")
VITE_SUPABASE_APK_BUCKET="apks"
VITE_SUPABASE_MEDIA_BUCKET="app-media"


# ------------------------------------------------------------------------------
# 2. SECRET SERVER-SIDE VARIABLES (NEVER exposed to the browser)
# ------------------------------------------------------------------------------

# Supabase Service Role Secret Key (Allows serverless API to perform admin authorization, signed URLs, and storage management)
SUPABASE_SERVICE_ROLE_KEY=""

# Optional: Google Gemini API Key for AI metadata enhancement and description generation
GEMINI_API_KEY=""

# Optional: Admin Secret Passphrase or designated admin email list
# (Supabase Auth email accounts with admin status can also be designated here or in admin_users table)
ADMIN_EMAILS="winterbuilds99@gmail.com"

